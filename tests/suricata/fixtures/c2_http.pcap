from scapy.all import Ether, IP, TCP, Raw, wrpcap

packets = [
    Ether()/IP(src="10.0.0.10", dst="93.184.216.34")/TCP(
        sport=49152, dport=80, flags="S", seq=1000
    ),
    Ether()/IP(src="93.184.216.34", dst="10.0.0.10")/TCP(
        sport=80, dport=49152, flags="SA", seq=2000, ack=1001
    ),
    Ether()/IP(src="10.0.0.10", dst="93.184.216.34")/TCP(
        sport=49152, dport=80, flags="A", seq=1001, ack=2001
    ),
    Ether()/IP(src="10.0.0.10", dst="93.184.216.34")/TCP(
        sport=49152, dport=80, flags="PA", seq=1001, ack=2001
    )/Raw(
        b"GET /beacon HTTP/1.1\r\n"
        b"Host: example.test\r\n"
        b"User-Agent: curl\r\n"
        b"Connection: close\r\n\r\n"
    ),
]
