{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-playbooks.dev/schemas/hunt_hypothesis.schema.json",
  "title": "Threat Hunting Hypothesis",
  "description": "Schema for machine-readable threat hunting hypotheses used by Security Playbooks.",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "description",
    "rationale",
    "mitre_attack",
    "data_sources",
    "queries",
    "success_criteria"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "validated",
        "deprecated",
        "retired"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "asset_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "mitre_attack": {
      "type": "object",
      "required": [
        "tactics",
        "techniques"
      ],
      "properties": {
        "tactics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TA\\d{4}$"
          },
          "uniqueItems": true
        },
        "techniques": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^T\\d{4}(?:\\.\\d{3})?$"
              },
              "name": {
                "type": "string",
                "minLength": 3
              },
              "relationship": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary",
                  "supporting"
                ]
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      },
      "uniqueItems": true
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "platform",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "platform": {
            "type": "string",
            "enum": [
              "kql",
              "spl",
              "elastic",
              "sql",
              "generic"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "expected_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "false_positive_considerations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "failure_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string",
            "enum": [
              "mitre",
              "vendor",
              "research",
              "internal",
              "other"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
