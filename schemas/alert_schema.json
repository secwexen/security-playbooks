{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-playbooks.local/schemas/alert_schema.json",
  "title": "Security Alert",
  "description": "Normalized alert generated during detection testing, lab simulation or security validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "timestamp",
    "rule_id",
    "rule_type",
    "severity",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_name": {
      "type": "string"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "sigma",
        "suricata",
        "yara",
        "custom"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "informational",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "investigating",
        "confirmed",
        "false_positive",
        "resolved"
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string"
        },
        "ip": {
          "type": "string"
        },
        "os": {
          "type": "string"
        }
      }
    },
    "user": {
      "type": "string"
    },
    "process": {
      "type": "object"
    },
    "network": {
      "type": "object"
    },
    "iocs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mitre_attack": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "type": "string"
        },
        "expected": {
          "type": "string",
          "enum": [
            "alert",
            "no_alert"
          ]
        },
        "actual": {
          "type": "string",
          "enum": [
            "alert",
            "no_alert"
          ]
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object"
    }
  }
}
