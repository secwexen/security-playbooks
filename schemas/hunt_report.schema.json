{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-playbooks.dev/schemas/hunt_report.schema.json",
  "title": "Threat Hunting Report",
  "description": "Schema for machine-readable threat hunting reports produced by Security Playbooks.",
  "type": "object",
  "required": [
    "id",
    "hypothesis_id",
    "title",
    "status",
    "summary",
    "scope",
    "execution",
    "findings",
    "conclusion",
    "recommendations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 100
    },
    "hypothesis_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-progress",
        "completed",
        "reviewed",
        "archived"
      ]
    },
    "analyst": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "scope": {
      "type": "object",
      "required": [
        "time_range"
      ],
      "properties": {
        "time_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "data_sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "queries"
      ],
      "properties": {
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "query_id",
              "name",
              "platform",
              "path"
            ],
            "properties": {
              "query_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 3
              },
              "platform": {
                "type": "string",
                "enum": [
                  "kql",
                  "spl",
                  "elastic",
                  "sql",
                  "generic"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "execution_status": {
                "type": "string",
                "enum": [
                  "not-run",
                  "success",
                  "failed",
                  "partial"
                ]
              },
              "result_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "confidence",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "informational",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "log",
                    "event",
                    "network",
                    "process",
                    "file",
                    "authentication",
                    "ioc",
                    "other"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "mitre_attack": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^T\\d{4}(?:\\.\\d{3})?$"
                },
                "name": {
                  "type": "string",
                  "minLength": 3
                }
              },
              "additionalProperties": false
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "conclusion": {
      "type": "string",
      "minLength": 20
    },
    "hypothesis_result": {
      "type": "string",
      "enum": [
        "confirmed",
        "partially-confirmed",
        "not-confirmed",
        "inconclusive"
      ]
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "priority",
          "action"
        ],
        "properties": {
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 5
          },
          "owner": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "iocs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ip",
              "domain",
              "url",
              "hash",
              "email",
              "filename",
              "process",
              "other"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string",
            "enum": [
              "mitre",
              "vendor",
              "research",
              "internal",
              "other"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
