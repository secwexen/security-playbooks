{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-playbooks.local/schemas/enrichment.schema.json",
  "title": "IOC Enrichment",
  "description": "Enrichment result associated with an IOC from threat intelligence sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ioc_id",
    "timestamp",
    "status"
  ],
  "properties": {
    "ioc_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "not_found",
        "failed"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed",
              "not_found",
              "rate_limited"
            ]
          },
          "reference": {
            "type": "string"
          }
        }
      },
      "uniqueItems": true
    },
    "reputation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "verdict": {
          "type": "string",
          "enum": [
            "benign",
            "suspicious",
            "malicious",
            "unknown"
          ]
        }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country": {
          "type": "string"
        },
        "country_code": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "asn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "organization": {
          "type": "string"
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "a": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aaaa": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mx": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "threat_actors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "malware_families": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mitre_attack": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      },
      "uniqueItems": true
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "raw": {
      "type": "object"
    }
  }
}
