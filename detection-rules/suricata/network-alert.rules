# Detects HTTP requests containing a curl User-Agent.
# Legitimate administrative scripts and automation may generate this traffic.

alert http any any -> any any (
    msg:"Potential Suspicious HTTP User-Agent - curl";
    flow:established,to_server;
    content:"User-Agent|3A| curl";
    http_header;
    classtype:policy-violation;
    sid:1000010;
    rev:1;
)
